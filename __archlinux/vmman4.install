post_install() {
    # Bash completion — always install
    /opt/bin/vmman completion bash > /etc/bash_completion.d/vmman

    # Zsh completion — only if zsh is present
    if command -v zsh > /dev/null 2>&1; then
        mkdir -p /usr/share/zsh/site-functions
        /opt/bin/vmman completion zsh > /usr/share/zsh/site-functions/_vmman
        zsh -c 'autoload -Uz compinit && compinit' 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /etc/bash_completion.d/vmman
    rm -f /usr/share/zsh/site-functions/_vmman
}