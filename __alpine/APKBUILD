# Maintainer: J.F.Gratton <jean-francois@famillegratton.net>
# Packager: Package builder <builder@famillegratton.net>
pkgname=vmman4
pkgver=0.4.0_pre
pkgrel=1
pkgdir=/data/packages
pkgdesc="Virtual Machine Manager"
url="https://git.famillegratton.net:3000/devops/vmman4.git"
arch=x86_64
license=GPL2
#depends="gcompat"
install="$pkgname.pre-deinstall $pkgname.post-install"
#source="$pkgname-$pkgver-$pkgrel.tar.bz2::http://localhost/$pkgname-$pkgver-$pkgrel.tar.bz2"
builddir="$startdir/src/BUILD"
binaryname=vmman
# libvirt-dev ships the headers plus all four pkg-config files the Go binding
# needs: libvirt.pc, libvirt-admin.pc, libvirt-qemu.pc and libvirt-lxc.pc.
# Runtime dep on libvirt-libs is auto-detected by abuild (so:libvirt.so.0).
makedepends="pkgconfig libvirt-dev"

prepare() {
	mkdir -p "$builddir"
	cp -R "$startdir"/../src/* "$builddir"/
}

build() {
	cd "$builddir"

	go env | egrep 'GOFLAGS|CGO_ENABLED|GOOS|GOARCH' || true

	# Static, non-PIE, internal linker
	CGO_ENABLED=1 go build -trimpath -ldflags="-s -w -buildid= -linkmode=internal" -o "$binaryname" .
}

package() {
	install -d "$pkgdir"/opt/bin
	install -m755 "$builddir/$binaryname" "$pkgdir/opt/bin/$binaryname"
}
